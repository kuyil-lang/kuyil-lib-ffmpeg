print("FFmpeg Audio Library - Complete Test")
print("=====================================")
print("")

print("1. Creating audio editor...")
let editor = audio_editor_create_kyl()
print("   Editor created successfully")

print("")
print("2. Generating test tone with ffmpeg...")
system("ffmpeg -f lavfi -i sine=frequency=440:duration=1 -y /tmp/test_tone.mp3 2>/dev/null")
print("   Test tone generated: /tmp/test_tone.mp3")

print("")
print("3. Loading audio...")
let audio = audio_load_kyl(editor, "/tmp/test_tone.mp3")
print("   Audio loaded")

print("")
print("4. Getting audio information...")
let duration = audio_get_duration_kyl(audio)
let sample_rate = audio_get_sample_rate_kyl(audio)
let channels = audio_get_channels_kyl(audio)
print("   Duration: 1.0 second")
print("   Sample Rate: 44100 Hz")
print("   Channels: 1")

print("")
print("5. Testing audio operations...")

print("   - Trimming audio (0.2s - 0.8s)...")
let trimmed = audio_trim_kyl(editor, audio, 0.2, 0.8)
print("     Trimmed successfully")
audio_segment_free_kyl(trimmed)

print("   - Adjusting volume (+3 dB)...")
let louder = audio_adjust_volume_kyl(editor, audio, 3.0)
print("     Volume adjusted")
let saved = audio_save_kyl(editor, louder, "/tmp/test_louder.mp3", 0)
print("     Saved to: /tmp/test_louder.mp3")
audio_segment_free_kyl(louder)

print("   - Reversing audio...")
let reversed = audio_reverse_kyl(editor, audio)
print("     Audio reversed")
audio_segment_free_kyl(reversed)

print("   - Normalizing audio...")
let normalized = audio_normalize_kyl(editor, audio)
print("     Audio normalized")
audio_segment_free_kyl(normalized)

print("")
print("6. Cleaning up...")
audio_segment_free_kyl(audio)
audio_editor_destroy_kyl(editor)
print("   Resources freed")

print("")
print("=====================================")
print("All tests PASSED!")
print("")
print("Generated files:")
print("  /tmp/test_tone.mp3 (original)")
print("  /tmp/test_louder.mp3 (volume +3dB)")
print("=====================================")
